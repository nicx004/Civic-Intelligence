generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

model User {
  id String @id @default(cuid())

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  password String?
  role     UserRole @default(USER)

  reports  Report[]
  comments Comment[]
  votes    Vote[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReportCategory {
  ROADS
  WATER_SUPPLY
  SEWAGE
  GARBAGE
  STREET_LIGHTING
  TRAFFIC
  ILLEGAL_CONSTRUCTION
  PARKS
  STRAY_ANIMALS
  PUBLIC_SAFETY
  OTHER
}

model Report {
  id String @id @default(cuid())

  title       String
  description String

  category ReportCategory
  status   ReportStatus @default(PENDING)

  ward      String
  locality  String
  landmark  String
  phone     String?

  latitude  Float?
  longitude Float?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  images   ReportImage[]
  comments Comment[]
  votes    Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportImage {
  id  String @id @default(cuid())
  url String

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Vote {
  id String @id @default(cuid())

  userId   String
  reportId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reportId])
}

model Comment {
  id String @id @default(cuid())

  content String

  userId   String
  reportId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}
